<Window x:Class="QuizletUltimate.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizletUltimate - Help Guide" 
        Width="800" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="Blue1" Color="#0466C8"/>
        <SolidColorBrush x:Key="Blue2" Color="#0353A4"/>
        <SolidColorBrush x:Key="Blue3" Color="#023E7D"/>
        <SolidColorBrush x:Key="Blue4" Color="#002855"/>
        <SolidColorBrush x:Key="Blue5" Color="#001845"/>
        <SolidColorBrush x:Key="Blue6" Color="#001233"/>
        <SolidColorBrush x:Key="Gray1" Color="#33415C"/>
        <SolidColorBrush x:Key="Gray2" Color="#5C677D"/>
        <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#001233" Offset="0"/>
            <GradientStop Color="#001845" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33415C" Offset="0"/>
            <GradientStop Color="#5C677D" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="8" Opacity="0.3" Color="#000000"/>
        <DropShadowEffect x:Key="BlueShadow" BlurRadius="3" ShadowDepth="1" Opacity="0.8" Color="#000000"/>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SectionBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#001845"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>

        <Style x:Key="ContentStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BlueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Blue1}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect" Value="{StaticResource BlueShadow}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ShortcutItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Gray1}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Border Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="16" 
                Effect="{StaticResource CardShadow}"
                Padding="32">

            <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Blue1}" 
                                CornerRadius="12" Padding="16" Margin="0,0,16,0">
                            <TextBlock Text="❓" FontSize="32" Foreground="{StaticResource TextLight}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="QuizletUltimate Help Guide" Style="{StaticResource HeaderStyle}" Margin="0"/>
                            <TextBlock Text="Everything you need to know to master your quizzes" 
                                       Style="{StaticResource ContentStyle}" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Getting Started -->
                    <Border Style="{StaticResource SectionBoxStyle}">
                        <TextBlock Text="🚀 Getting Started" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <StackPanel Margin="0,0,0,8">
                        <!-- Step 1: Add margin below to separate it from step 2 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="1. Click " Style="{StaticResource ContentStyle}" Margin="0"/>
                            <TextBlock Text="Sample" Style="{StaticResource BlueTextStyle}" Margin="0"/>
                            <TextBlock Text=" to download our example quiz format." Style="{StaticResource ContentStyle}" Margin="0"/>
                        </StackPanel>

                        <TextBlock Text="2. Copy the sample text and paste it into your favorite AI chatbot (ChatGPT, Claude, etc.)." 
               Style="{StaticResource ContentStyle}"/>

                        <TextBlock Text="3. Add your study material or document text below the sample prompt." 
               Style="{StaticResource ContentStyle}"/>

                        <TextBlock Text="4. AI will generate the quiz questions in the same format." 
               Style="{StaticResource ContentStyle}"/>

                        <!-- Step 5: Add margin below to separate it from step 6 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="5. Download the generated file and click " Style="{StaticResource ContentStyle}" Margin="0"/>
                            <TextBlock Text="Import" Style="{StaticResource BlueTextStyle}" Margin="0"/>
                            <TextBlock Text=" to load your personalized quiz." Style="{StaticResource ContentStyle}" Margin="0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="6. Select your preferred question types in " Style="{StaticResource ContentStyle}" Margin="0"/>
                            <TextBlock Text="Categories" Style="{StaticResource BlueTextStyle}" Margin="0"/>
                            <TextBlock Text=" and start learning!" Style="{StaticResource ContentStyle}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>


                    <!-- Question Types -->
                    <Border Style="{StaticResource SectionBoxStyle}">
                        <TextBlock Text="📝 Question Types" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="• Multiple Choice" Style="{StaticResource ContentStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Select one or more correct answers" Style="{StaticResource ContentStyle}" Margin="16,0,0,12"/>

                            <TextBlock Text="• True/False" Style="{StaticResource ContentStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose whether the statement is true or false" Style="{StaticResource ContentStyle}" Margin="16,0,0,12"/>

                            <TextBlock Text="• Text Input" Style="{StaticResource ContentStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Type the correct answer" Style="{StaticResource ContentStyle}" Margin="16,0,0,12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0">
                            <TextBlock Text="• Matching" Style="{StaticResource ContentStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Drag items to match pairs correctly" Style="{StaticResource ContentStyle}" Margin="16,0,0,12"/>

                            <TextBlock Text="• Ordering" Style="{StaticResource ContentStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Arrange items in the correct sequence" Style="{StaticResource ContentStyle}" Margin="16,0,0,12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Keyboard Shortcuts -->
                    <Border Style="{StaticResource SectionBoxStyle}">
                        <TextBlock Text="⌨️ Keyboard Shortcuts" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Navigation" FontWeight="SemiBold" Style="{StaticResource BlueTextStyle}"/>
                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Space/Enter" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Submit/Next" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="R" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Restart Quiz" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Escape" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Quit Application" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0">
                            <TextBlock Text="Question Answers" FontWeight="SemiBold" Style="{StaticResource BlueTextStyle}"/>
                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1-9" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Select Multiple Choice" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="T/F" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="True/False Answer" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ShortcutItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Enter" FontWeight="Bold" Style="{StaticResource ContentStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Submit Text Input" Style="{StaticResource ContentStyle}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Learning Modes -->
                    <Border Style="{StaticResource SectionBoxStyle}">
                        <TextBlock Text="🎯 Learning Modes" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Learning:" FontWeight="Bold" Style="{StaticResource BlueTextStyle}" Margin="0,0,4,5"/>
                            <TextBlock Text="Practice all questions in random order; missed ones are saved for revision." Style="{StaticResource ContentStyle}" Margin="0,0,0,5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Revision:" FontWeight="Bold" Style="{StaticResource BlueTextStyle}" Margin="0,0,4,5"/>
                            <TextBlock Text="Focus on missed questions, in the original order you encountered them." Style="{StaticResource ContentStyle}" Margin="0,0,0,5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Review:" FontWeight="Bold" Style="{StaticResource BlueTextStyle}" Margin="0,0,4,0"/>
                            <TextBlock Text="See your most challenging questions and overall performance statistics." Style="{StaticResource ContentStyle}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Pro Tips -->
                    <Border Style="{StaticResource SectionBoxStyle}">
                        <TextBlock Text="💡 Pro Tips" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="• Questions you answer incorrectly will return in Revision mode" Style="{StaticResource ContentStyle}"/>
                        <TextBlock Text="• Use the task counter (📋) to track how many questions need revision" Style="{StaticResource ContentStyle}"/>
                        <TextBlock Text="• Drag and drop items to answer Matching and Ordering questions." Style="{StaticResource ContentStyle}"/>
                        <TextBlock Text="• Text answers allow small typos with smart matching." Style="{StaticResource ContentStyle}"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Content="Got it!" 
                            HorizontalAlignment="Center" 
                            Margin="0,32,0,16"
                            Padding="24,12"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="{StaticResource Blue1}"
                            Foreground="{StaticResource TextLight}"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="12"
                                        Effect="{StaticResource CardShadow}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Blue2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>